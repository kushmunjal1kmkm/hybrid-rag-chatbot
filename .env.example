# ─────────────────────────────────────────────────────────────────────────────
#  ChatMind — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: LLM Provider (at least one) ────────────────────────────────────
GROQ_API_KEY=gsk_...                 # https://console.groq.com  (free, recommended)
OPENAI_API_KEY=sk-...                # https://platform.openai.com  (optional)
ANTHROPIC_API_KEY=sk-ant-...         # https://console.anthropic.com  (optional)

# ── Required for Web Search ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...              # https://app.tavily.com  (free tier available)

# ── Embeddings ────────────────────────────────────────────────────────────────
# Options: "huggingface" (local, free, default) | "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2    # ~90 MB download on first run (HuggingFace only)

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SEARCH_RESULTS=5
